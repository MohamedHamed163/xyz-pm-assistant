# Copy to .env (never commit .env) and export before running the API.

# Postgres connection for the app (owner role: migrations, seeding, ingestion worker).
DATABASE_URL=dbname=xyz_pm

# Signing key for login tokens. If unset, a random one is generated per process (tokens reset on restart).
JWT_SECRET=change-me-to-a-long-random-string

# Shared password for the fictional demo users. A test value — not a real credential.
DEMO_PASSWORD=xyz-demo-2026
# Shows the demo-user picker on the login page. Turn off for anything that is not a demo.
DEMO_MODE=true

# Optional: real embeddings + answers. Without it, offline embedder + extractive answerer are used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# RAG_MAX_DISTANCE=0.77
